# Studio Editor engine (creator.switchbeats.studio). The engine holds no
# session or credentials; the storefront page passes it audio over an
# origin-checked postMessage bridge. Only the storefront may frame it (plus
# local development pages).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; font-src 'self' data:; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://switchbeats.studio https://www.switchbeats.studio http://localhost:* http://127.0.0.1:*
  Permissions-Policy: microphone=(self "https://switchbeats.studio" "https://www.switchbeats.studio"), camera=(), geolocation=(), payment=()

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; font-src 'self' data:; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://switchbeats.studio https://www.switchbeats.studio http://localhost:* http://127.0.0.1:*
  Permissions-Policy: microphone=(self "https://switchbeats.studio" "https://www.switchbeats.studio"), camera=(), geolocation=(), payment=()

# Analyzer windows opened by the engine itself still use inline scripts.
/eq.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
/sp.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
/mix.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Open-source license notices (static, no scripts).
/licenses
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://switchbeats.studio https://www.switchbeats.studio
