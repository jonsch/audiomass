{
  // Cloudflare Workers Static Assets deploy for the SwitchBeats Studio Editor
  // engine at creator.switchbeats.studio (custom domain; Cloudflare creates the
  // DNS record and certificate). Headers live in src/_headers; excluded files
  // in src/.assetsignore.
  "$schema": "https://unpkg.com/wrangler@4.135.0/config-schema.json",
  "name": "switchbeats-creator",
  "compatibility_date": "2026-09-25",
  "routes": [{ "pattern": "creator.switchbeats.studio", "custom_domain": true }],
  "assets": {
    "directory": "./src",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
